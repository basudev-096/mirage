FROM golang:alpine AS builder
WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download || true
COPY . .
RUN go build -o mirage-proxy ./cmd/mirage-proxy

FROM alpine:latest
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /app/mirage-proxy .
COPY deploy/certs /app/certs
EXPOSE 8443
CMD ["./mirage-proxy", "-listen", ":8443", "-target", "http://backend:8080", "-cert", "/app/certs/server.crt", "-key", "/app/certs/server.key"]
